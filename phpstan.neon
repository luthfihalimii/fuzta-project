includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # casts() diberi docblock @return array<string, string>, jadi Larastan
    # membaca PHPDoc itu dan mengabaikan isi casts(). Parse body-nya langsung.
    parseModelCastsMethod: true
