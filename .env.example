APP_NAME="Pizza Fruzta"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-domain.example
APP_TIMEZONE=UTC

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pizza_fruzta
DB_USERNAME=pizza_fruzta
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Must be true in production (HTTPS).
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
IMAGES_DISK=public
# R2 (foto produk di produksi): buat bucket PUBLIC, token API, endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Nightly database backup (see docs/operations/backup-restore.md).
BACKUP_ENABLED=false
BACKUP_TIME=02:00
BACKUP_DIR=/var/backups/pizza-fruzta
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=pizza-fruzta

# Dev-stable values — sama untuk semua dev-fork; produksi harus generate baru (php artisan reverb:make:app)
REVERB_APP_ID=1
REVERB_KEY=ZnV6dGEtZGV2LWtleS0yMDI2LTAwMDAwMDAwMDAwMDE=
REVERB_SECRET=ZnV6dGEtZGV2LXNlY3JldC0yMDI2LTAwMDAwMDAwMDI=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY=ZnV6dGEtZGV2LWtleS0yMDI2LTAwMDAwMDAwMDAwMDE=
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=ws

KITCHEN_LATE_MINUTES=15
